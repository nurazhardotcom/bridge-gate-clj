{:paths ["src" "policies" "test"]
 ;; Clojure-CLI parity only. The supported runner is Babashka (`bb`),
 ;; which bundles cheshire / tools.cli / http-client / clojure.test.
 ;; On plain JVM Clojure, only the pure namespaces (bridge.config,
 ;; bridge.policy) and mock-injected tests run; live HTTP needs `bb`.
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}}}
